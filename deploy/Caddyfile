{
	# Единый формат журналов: share-токены в пути заменяются и в access-, и в
	# error-записях. Защищённые заголовки (Cookie/Authorization) Caddy редактирует
	# сам. Так край не раскрывает ссылку при публичном отказе.
	log {
		format filter {
			request>uri regexp "^(/(?:api/shared|r)/)[^/?#]+" "${1}REDACTED"
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Доступ-логи JSON в stdout; docker json-file уже ограничен по размеру/числу.
	log

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /health {
		reverse_proxy backend:8080
	}

	handle /ready {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}
