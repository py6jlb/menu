# Сервер: скопировать в /opt/menu/server.conf (chmod 600).
# KEY=value; всё после первого = буквально, без shell/Compose-подстановок.
# Кавычки не нужны: они станут частью значения. Комментарии — отдельными строками.

# Docker Hub (тот же namespace, что в локальном файле)
DOCKERHUB_USER=your-dockerhub-login
# IMAGE_TAG намеренно не задан: закреплённый тег берётся из /opt/menu/current-release,
# который пишет remote-deploy, поэтому обычный перезапуск Compose остаётся на
# выбранной версии, а не уходит на latest. Задай явно, только чтобы вручную
# закрепить другой тег (он получит приоритет над current-release).
# IMAGE_TAG=abc123

# Режим запуска. production (по умолчанию) требует HTTPS-адрес, настроенную почту
# и случайные секреты. Лабораторный HTTP без писем включается явно: lab.
DEPLOYMENT_MODE=production
# Публичный адрес приложения; в production обязателен https://<домен>.
PUBLIC_BASE_URL=https://menu.example.com

# Postgres (production: случайный пароль, не шаблонный; минимум 12 символов)
POSTGRES_DB=menu_planner
POSTGRES_USER=menu
POSTGRES_PASSWORD=change-me-strong

# JWT (production: случайный секрет, минимум 32 символа, не шаблонный)
JWT_SECRET=change-me-min-32-chars-0123456789abcdef
JWT_ISSUER=menu-planner
JWT_AUDIENCE=menu-planner-client

# SMTP (production обязателен; только защищённое соединение)
# SMTP_SECURITY=starttls — явно требуемый STARTTLS (порт 587),
# SMTP_SECURITY=ssl — неявный TLS (порт 465). Даунгрейда и отключения
# проверки сертификата нет. Пусто — письма в лог только в lab.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Меню для домохозяек
SMTP_SECURITY=starttls
# Предел ожидания SMTP-операций, 1–300 секунд; сбой не считается доставкой.
SMTP_TIMEOUT_SECONDS=10
# smtp (по умолчанию) или log — dev/test-запись полного письма в журнал,
# доступна только в lab. В production log запрещён.
EMAIL_TRANSPORT=smtp

# Caddy: ":80" до домена (только lab), "example.com" для авто-HTTPS
DOMAIN=:80

# Базовый URL для ссылок шаринга (пусто — ссылка отдаётся относительной и
# разрешается фронтендом относительно текущего домена)
SHARE_BASE_URL=

# Бэкапы: rclone-remote вида "myremote:bucket/menu" (настроен через rclone config)
BACKUP_REMOTE=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Оповещения (menu-monitor.timer): канал оператора. URL секретен и не логируется.
# ALERT_WEBHOOK_URL — обязателен для проверки; на него уходит JSON {"text": ...}.
# ALERT_HEARTBEAT_URL — внешний dead-man switch (healthchecks.io, Uptime Kuma):
# пинг при каждом запуске, тишина там означает полный отказ VPS.
ALERT_WEBHOOK_URL=
ALERT_HEARTBEAT_URL=
# Публичный адрес проверки пути; пусто — берётся PUBLIC_BASE_URL/DOMAIN.
ALERT_PUBLIC_URL=
# Пороги: возраст complete-набора (ч), свободное место (МБ), занятость диска (%),
# доступная память (МБ), load1 на ядро; окно дедупликации повторов (с).
BACKUP_MAX_AGE_HOURS=26
ALERT_DISK_MIN_FREE_MB=2048
ALERT_DISK_MAX_USED_PERCENT=90
ALERT_MEM_MIN_MB=256
ALERT_LOAD_MAX_PER_CPU=2
ALERT_DEDUP_SECONDS=3600

# Дополнительные серверные ключи (обычно достаточно defaults):
# COMPOSE_FILE=docker-compose.prod.yml
# DRILL_CONTAINER=menu-restore-drill
